{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadInvoices",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::icem-invoice-demo-tanujakale083-2026/invoice/*"
    },
    {
      "Sid": "WriteSummaries",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::icem-invoice-demo-tanujakale083-2026/processed/*"
    },
    {
      "Sid": "SendEmailNotification",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:ap-south-1:216423694381:invoice-alerts"
    }
  ]
}